case "${1:-help}" in
  threads)        shift; cmd_threads "$@" ;;
  thread)         shift; cmd_thread "$@" ;;
  create-thread)  shift; cmd_create_thread "$@" ;;
  messages)       shift; cmd_messages "$@" ;;
  post)         shift; cmd_post "$@" ;;
  reply)        shift; cmd_reply "$@" ;;
  reply-last)   shift; cmd_reply_last "$@" ;;
  join)         shift; cmd_join "$@" ;;
  files)        shift; cmd_files "$@" ;;
  read)         shift; cmd_read "$@" ;;
  write)        shift; cmd_write "$@" ;;
  channels)     shift; cmd_channels "$@" ;;
  channel)      shift; cmd_channel "$@" ;;
  tasks)        shift; cmd_tasks "$@" ;;
  task-add)     shift; cmd_task_add "$@" ;;
  task-done)    shift; cmd_task_done "$@" ;;
  history)      shift; cmd_history "$@" ;;
  export)       shift; cmd_export "$@" ;;
  tags)         shift; cmd_tags "$@" ;;
  poll)         shift; cmd_poll "$@" ;;
  setup)        shift; cmd_setup "$@" ;;
  profiles)     cmd_profiles ;;
  update)       cmd_update ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *) echo "Unknown command: $1. Run 'muleteam help' for usage." >&2; exit 1 ;;
esac
