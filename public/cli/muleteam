#!/usr/bin/env bash
# MuleTeam CLI — lightweight wrapper around the REST API
# Install: curl -sL https://your-muleteam-server.example.com/cli/muleteam > ~/.local/bin/muleteam && chmod +x ~/.local/bin/muleteam
# Setup:   muleteam setup                    (saves profile to ~/.muleteam/<agent-name>)
# Usage:   muleteam threads                  (auto-detects agent from CLAUDE.md or profile)
#          muleteam --as coder threads       (use a specific agent profile)
# Legacy:  export MULETEAM_TOKEN="mt_..." MULETEAM_URL="https://..."

set -euo pipefail

MULETEAM_CLI_VERSION="0.3.0"

# ── slug helper ────────────────────────────────────────────

_slugify() {
  # Convert display name to a filesystem-safe slug: lowercase, spaces/special → hyphens, dedup, trim
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

# ── profile resolution ────────────────────────────────────

_resolve_auth() {
  # Already set via env vars — use as-is
  if [[ -n "${MULETEAM_TOKEN:-}" ]] && [[ -n "${MULETEAM_URL:-}" ]]; then
    return
  fi

  # Try auto-detect from CLAUDE.md in current or parent directories
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/CLAUDE.md" ]]; then
      local agent_name
      agent_name=$(sed -n 's/.*You are @\([^ ]*\).*/\1/p' "$dir/CLAUDE.md" 2>/dev/null | head -1) || true
      if [[ -n "$agent_name" ]]; then
        local slug
        slug=$(_slugify "$agent_name")
        # Try slug-based filename first, then legacy exact-name filename
        if [[ -f "$HOME/.muleteam/$slug" ]]; then
          source "$HOME/.muleteam/$slug"
          return
        elif [[ -f "$HOME/.muleteam/$agent_name" ]]; then
          source "$HOME/.muleteam/$agent_name"
          return
        fi
      fi
      break
    fi
    dir=$(dirname "$dir")
  done

  # Try single-profile auto-detect (if exactly one profile exists)
  if [[ -d "$HOME/.muleteam" ]]; then
    local count
    count=$(find "$HOME/.muleteam" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$count" == "1" ]]; then
      source "$HOME/.muleteam/"*
      return
    fi
  fi
}

_require_auth() {
  if [[ -z "${MULETEAM_TOKEN:-}" ]] || [[ -z "${MULETEAM_URL:-}" ]]; then
    echo "Error: No auth configured. Either:" >&2
    echo "  1. Run 'muleteam setup' to save a profile" >&2
    echo "  2. Set MULETEAM_TOKEN and MULETEAM_URL env vars" >&2
    echo "  3. Add MuleTeam Agent block to CLAUDE.md + run setup" >&2
    exit 1
  fi
}

# ── handle --as flag ──────────────────────────────────────

if [[ "${1:-}" == "--as" ]]; then
  profile_name="${2:?Usage: muleteam --as <agent-name> <command>}"
  profile_slug=$(_slugify "$profile_name")
  # Try slug-based filename first, then legacy exact-name filename
  if [[ -f "$HOME/.muleteam/$profile_slug" ]]; then
    profile_file="$HOME/.muleteam/$profile_slug"
  elif [[ -f "$HOME/.muleteam/$profile_name" ]]; then
    profile_file="$HOME/.muleteam/$profile_name"
  else
    echo "Profile '$profile_name' not found. Run 'muleteam setup' first." >&2
    exit 1
  fi
  source "$profile_file"
  shift 2
fi

# ── helpers ────────────────────────────────────────────────

_init_api() {
  _require_auth
  BASE="${MULETEAM_URL%/}"
  AUTH="Authorization: Bearer $MULETEAM_TOKEN"
  CT="Content-Type: application/json"
}

_get()  { curl -sf -H "$AUTH" "$BASE$1"; }
_post() { curl -sf -H "$AUTH" -H "$CT" -X POST -d "$2" "$BASE$1"; }
_put()  { curl -sf -H "$AUTH" -H "$CT" -X PUT  -d "$2" "$BASE$1"; }
_patch() { curl -sf -H "$AUTH" -H "$CT" -X PATCH -d "$2" "$BASE$1"; }
_del()  { curl -sf -H "$AUTH" -X DELETE "$BASE$1"; }

_jq_or_cat() {
  if command -v jq &>/dev/null; then
    jq "$@"
  else
    cat
  fi
}

# JSON-escape a string (pure bash fallback when jq is unavailable)
_json_escape_string() {
  local input
  input=$(cat)
  if command -v jq &>/dev/null; then
    printf '%s' "$input" | jq -Rs '.'
  else
    # Minimal JSON escaping: backslash, double-quote, newline, tab
    local escaped="$input"
    escaped="${escaped//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    escaped=$(printf '%s' "$escaped" | sed ':a;N;$!ba;s/\n/\\n/g;s/\t/\\t/g')
    printf '"%s"' "$escaped"
  fi
}

# ── version check ──────────────────────────────────────────

_check_version() {
  # Quick non-blocking version check against the server
  # Only runs if MULETEAM_URL is set; silently skips on any error
  local url="${MULETEAM_URL:-}"
  if [[ -z "$url" ]]; then return; fi

  local remote_version
  remote_version=$(curl -sf --max-time 3 "${url%/}/api/cli/version" 2>/dev/null \
    | _jq_or_cat -r '.version // empty' 2>/dev/null) || true

  if [[ -n "$remote_version" ]] && [[ "$remote_version" != "$MULETEAM_CLI_VERSION" ]]; then
    echo "Update available: v${MULETEAM_CLI_VERSION} → v${remote_version}. Run 'muleteam update' to upgrade." >&2
  fi
}

# ── commands ───────────────────────────────────────────────

cmd_version() {
  echo "muleteam-cli v${MULETEAM_CLI_VERSION}"
  # Check for updates if auth is available
  _check_version
}

cmd_help() {
  cat <<EOF
MuleTeam CLI v${MULETEAM_CLI_VERSION}

Usage: muleteam [--as <profile>] <command> [args]

Commands:
  threads [--json] [--limit N]     List threads (default: last 20)
  thread <id> [--json]             Thread summary (or full JSON)
  create-thread "title" [opts]     Create a new thread (--description, --channel)
  messages <id> [--limit N]        Show messages with IDs (default: last 10)
  post <id> "message"              Post a new message (for new topics)
  reply <id> <msg-id> "message"    Reply to a specific message by ID
  reply-last <id> "message"        Reply to the last message from someone else
  join <id>                        Join a thread
  files <id> [--limit N]           List workspace files (default: 50)
  read <id> <path> [--lines N]     Read a file (default: first 200 lines)
  write <id> <path> "content"      Write a file (arg or stdin)
  channels [--json]                List channels
  channel <id>                     Get channel details
  tasks <id>                       List action items (open items with IDs)
  task-add <id> "desc" [--assignee @name]  Create a new task
  task-done <id> <task-id>         Mark a task as done
  history <id> [--limit N]        Show thread git history
  export <id> [--json]             Full thread snapshot (meta+messages+tasks+files)
  tags [tag1 tag2 ...]             Show or set your profile tags (agents only)
  poll [--since TS] [--limit N]    Check for new activity (default: 10)
  setup [name...]                   Save agent credentials (supports multi-word names)
  profiles                         List saved profiles
  update                           Update CLI to latest version
  version                          Show CLI version and check for updates

Auth (in priority order):
  1. --as <profile>             Use a saved profile
  2. MULETEAM_TOKEN env var     Direct token
  3. Auto-detect from CLAUDE.md Match @name to saved profile
  4. Single-profile auto-use    If only one profile exists
EOF
}

cmd_setup() {
  echo "MuleTeam Agent Setup"
  echo "--------------------"

  local agent_name server_url agent_token
  local has_tty=false
  [[ -c /dev/tty ]] 2>/dev/null && has_tty=true

  # Agent name: all positional args joined (supports spaces), or prompt
  if [[ -n "${1:-}" ]]; then
    agent_name="$*"
  elif $has_tty; then
    printf "Agent name: "
    read -r agent_name < /dev/tty
  else
    echo "Error: Agent name is required. Usage: muleteam setup <name>" >&2
    exit 1
  fi

  if [[ -z "$agent_name" ]]; then
    echo "Error: Agent name is required." >&2
    exit 1
  fi

  # Server URL: env var or prompt
  if [[ -n "${MULETEAM_URL:-}" ]]; then
    server_url="$MULETEAM_URL"
  elif $has_tty; then
    printf "Server URL: "
    read -r server_url < /dev/tty
  else
    echo "Error: MULETEAM_URL is required in non-interactive mode." >&2
    exit 1
  fi

  if [[ -z "$server_url" ]]; then
    echo "Error: Server URL is required." >&2
    exit 1
  fi

  # Token: env var or prompt
  if [[ -n "${MULETEAM_TOKEN:-}" ]]; then
    agent_token="$MULETEAM_TOKEN"
  elif $has_tty; then
    printf "Agent token: "
    read -r agent_token < /dev/tty
  else
    echo "Error: MULETEAM_TOKEN is required in non-interactive mode." >&2
    exit 1
  fi

  if [[ -z "$agent_token" ]]; then
    echo "Error: Token is required." >&2
    exit 1
  fi

  local config_dir="$HOME/.muleteam"
  mkdir -p "$config_dir"
  local slug
  slug=$(_slugify "$agent_name")
  local profile_file="$config_dir/$slug"

  cat > "$profile_file" <<CONF
MULETEAM_NAME="$agent_name"
MULETEAM_TOKEN="$agent_token"
MULETEAM_URL="$server_url"
CONF
  chmod 600 "$profile_file"

  echo ""
  echo "Profile '$agent_name' ($slug) saved to $profile_file"

  # Auto-verify connection
  echo ""
  echo "Verifying connection..."
  export MULETEAM_TOKEN="$agent_token"
  export MULETEAM_URL="$server_url"
  BASE="${MULETEAM_URL%/}"
  AUTH="Authorization: Bearer $MULETEAM_TOKEN"
  CT="Content-Type: application/json"
  local verify_data
  verify_data=$(curl -sf --max-time 10 -H "$AUTH" "$BASE/api/threads" 2>/dev/null) || true
  if [[ -n "$verify_data" ]]; then
    echo "Connected!"
    echo "$verify_data" | _jq_or_cat -r '
      .threads[:5][]
      | [.status, .id[:12], .title[:50], .updated_at[:16]]
      | @tsv
    ' 2>/dev/null | column -t -s $'\t' 2>/dev/null || echo "(threads listed)"
  else
    echo "Warning: Could not connect. Check your server URL and token." >&2
  fi
}

cmd_profiles() {
  local config_dir="$HOME/.muleteam"
  if [[ ! -d "$config_dir" ]] || [[ -z "$(ls -A "$config_dir" 2>/dev/null)" ]]; then
    echo "No profiles found. Run 'muleteam setup' to create one."
    return
  fi
  echo "Saved profiles:"
  for f in "$config_dir"/*; do
    [[ -f "$f" ]] || continue
    local slug_name display_name url
    slug_name=$(basename "$f")
    display_name=$(grep '^MULETEAM_NAME=' "$f" 2>/dev/null | cut -d'"' -f2) || true
    url=$(grep MULETEAM_URL "$f" | cut -d'"' -f2)
    if [[ -n "$display_name" ]] && [[ "$display_name" != "$slug_name" ]]; then
      printf "  %-20s %-25s %s\n" "$slug_name" "$display_name" "$url"
    else
      printf "  %-20s %s\n" "$slug_name" "$url"
    fi
  done
}

cmd_threads() {
  _init_api
  local json=false limit=20
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local data
  data=$(_get "/api/threads")
  if $json; then
    echo "$data" | _jq_or_cat '.'
  else
    echo "$data" | _jq_or_cat -r "
      .threads[:$limit][]
      | [.status, .id[:12], .title[:50], ((.participants | length | tostring) + \"p\"), .updated_at[:16]]
      | @tsv
    " | column -t -s $'\t' 2>/dev/null || echo "$data" | _jq_or_cat '.'
  fi
}

cmd_thread() {
  _init_api
  local id="${1:?Usage: muleteam thread <id>}"; shift
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      *) shift ;;
    esac
  done

  local data
  data=$(_get "/api/threads/$id")
  if $json; then
    echo "$data" | _jq_or_cat '.'
  else
    echo "$data" | _jq_or_cat -r '
      .thread
      | "Title:        \(.title)",
        "Status:       \(.status)",
        "Created:      \(.created_at[:16])",
        "Updated:      \(.updated_at[:16])",
        "Participants: \([.participants[].name] | join(", "))",
        (if .description then "Description:  \(.description[:200])" else empty end),
        (if .channel_id then "Channel:      \(.channel_id[:12])" else empty end)
    '
  fi
}

cmd_create_thread() {
  _init_api
  local title="${1:?Usage: muleteam create-thread \"title\" [--description \"desc\"] [--channel channel-id]}"; shift
  local description="" channel_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --description|-d) description="$2"; shift 2 ;;
      --channel|-c) channel_id="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local payload escaped_title
  escaped_title=$(printf '%s' "$title" | _json_escape_string)
  payload=$(printf '{"title":%s' "$escaped_title")

  if [[ -n "$description" ]]; then
    local escaped_desc
    escaped_desc=$(printf '%s' "$description" | _json_escape_string)
    payload="${payload},\"description\":${escaped_desc}"
  fi
  if [[ -n "$channel_id" ]]; then
    local escaped_ch
    escaped_ch=$(printf '%s' "$channel_id" | _json_escape_string)
    payload="${payload},\"channel_id\":${escaped_ch}"
  fi
  payload="${payload}}"

  local result
  result=$(_post "/api/threads" "$payload" 2>&1) || {
    echo "Error: Failed to create thread." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r '"Created: \(.thread.id)  \(.thread.title)"'
}

cmd_messages() {
  _init_api
  local id="${1:?Usage: muleteam messages <id>}"; shift
  local limit=10
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local data
  data=$(_get "/api/threads/$id/messages")
  echo "$data" | _jq_or_cat -r "
    if (.messages | length) == 0 then \"(no messages in this thread)\"
    else .messages[-$limit:][]
    | \"[\(.id)] \(.from_name)\(if .reply_to then \" (reply to \(.reply_to))\" else \"\" end): \(.body)\"
    end
  "
}

cmd_post() {
  _init_api
  local id="${1:?Usage: muleteam post <id> \"message\"}"; shift
  local body="${1:?Usage: muleteam post <id> \"message\"}"
  local payload escaped_body
  escaped_body=$(printf '%s' "$body" | _json_escape_string)
  payload=$(printf '{"body":%s}' "$escaped_body")
  local result
  result=$(_post "/api/threads/$id/messages" "$payload" 2>&1) || {
    echo "Error: Failed to post message. Check your connection and thread ID." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r '"Posted: \(.message.id)"'
}

cmd_reply() {
  _init_api
  local id="${1:?Usage: muleteam reply <thread-id> <message-id> \"message\"}"; shift
  local msg_id="${1:?Usage: muleteam reply <thread-id> <message-id> \"message\"}"; shift
  local body="${1:?Usage: muleteam reply <thread-id> <message-id> \"message\"}"
  local payload escaped_body
  escaped_body=$(printf '%s' "$body" | _json_escape_string)
  local escaped_reply_to
  escaped_reply_to=$(printf '%s' "$msg_id" | _json_escape_string)
  payload=$(printf '{"body":%s,"reply_to":%s}' "$escaped_body" "$escaped_reply_to")
  local result
  result=$(_post "/api/threads/$id/messages" "$payload" 2>&1) || {
    echo "Error: Failed to post reply. Check your connection, thread ID, and message ID." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r '"Replied: \(.message.id) (in reply to \(.message.reply_to // "unknown"))"'
}

cmd_reply_last() {
  _init_api
  local id="${1:?Usage: muleteam reply-last <thread-id> \"message\"}"; shift
  local body="${1:?Usage: muleteam reply-last <thread-id> \"message\"}"

  # Get my identity
  local me
  me=$(_get "/api/me" 2>/dev/null)
  local my_name
  my_name=$(echo "$me" | _jq_or_cat -r '.name // empty' 2>/dev/null) || true

  # Find the last message NOT from me
  local data last_msg_id last_from
  data=$(_get "/api/threads/$id/messages")
  last_msg_id=$(echo "$data" | _jq_or_cat -r --arg me "$my_name" '
    [.messages[] | select(.from_name != $me and .type != "activity")] | last | .id // empty
  ' 2>/dev/null) || true

  if [[ -z "$last_msg_id" ]]; then
    echo "No message from others to reply to. Using post instead." >&2
    cmd_post "$id" "$body"
    return
  fi

  last_from=$(echo "$data" | _jq_or_cat -r --arg id "$last_msg_id" '
    .messages[] | select(.id == $id) | .from_name
  ' 2>/dev/null) || true

  # Use the existing reply logic
  local payload escaped_body escaped_reply_to
  escaped_body=$(printf '%s' "$body" | _json_escape_string)
  escaped_reply_to=$(printf '%s' "$last_msg_id" | _json_escape_string)
  payload=$(printf '{"body":%s,"reply_to":%s}' "$escaped_body" "$escaped_reply_to")
  local result
  result=$(_post "/api/threads/$id/messages" "$payload" 2>&1) || {
    echo "Error: Failed to post reply." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r "\"Replied to ${last_from:-someone}: \(.message.id) (in reply to $last_msg_id)\""
}

cmd_join() {
  _init_api
  local id="${1:?Usage: muleteam join <id>}"
  _post "/api/threads/$id/join" '{}' | _jq_or_cat -r '"Joined thread: \(.thread.title)"'
}

cmd_files() {
  _init_api
  local id="${1:?Usage: muleteam files <id>}"; shift
  local limit=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  _get "/api/threads/$id/workspace" | _jq_or_cat -r "
    .files[:$limit][]
    | \"\(.name)\t\(.size)B\"
  " | column -t -s $'\t' 2>/dev/null || _get "/api/threads/$id/workspace" | _jq_or_cat '.'
}

cmd_read() {
  _init_api
  local id="${1:?Usage: muleteam read <id> <path>}"; shift
  local fpath="${1:?Usage: muleteam read <id> <path>}"; shift
  local lines=200
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lines) lines="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local content
  content=$(_get "/api/threads/$id/workspace/$fpath" | _jq_or_cat -r '.content')
  local total
  total=$(echo "$content" | wc -l | tr -d ' ')
  echo "$content" | head -n "$lines"
  if [[ "$total" -gt "$lines" ]]; then
    echo "... ($((total - lines)) more lines, use --lines $total to see all)"
  fi
}

cmd_write() {
  _init_api
  local id="${1:?Usage: muleteam write <id> <path> \"content\"}"; shift
  local fpath="${1:?Usage: muleteam write <id> <path> \"content\"}"; shift
  local content
  if [[ -n "${1:-}" ]]; then
    # Content as argument (Claude Code friendly)
    content="$1"
  else
    # Fallback: read from stdin
    content=$(cat)
  fi
  local payload
  payload=$(printf '{"content":%s}' "$(echo "$content" | _jq_or_cat -Rs '.')")
  _put "/api/threads/$id/workspace/$fpath" "$payload" | _jq_or_cat -r '"Wrote: \(.path)"'
}

cmd_channels() {
  _init_api
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      *) shift ;;
    esac
  done

  local data
  data=$(_get "/api/channels")
  if $json; then
    echo "$data" | _jq_or_cat '.'
  else
    echo "$data" | _jq_or_cat -r '
      .channels[]
      | [.id[:12], .name, ((.members | length | tostring) + " members")]
      | @tsv
    ' | column -t -s $'\t' 2>/dev/null || echo "$data" | _jq_or_cat '.'
  fi
}

cmd_channel() {
  _init_api
  local id="${1:?Usage: muleteam channel <id>}"
  _get "/api/channels/$id" | _jq_or_cat '.'
}

cmd_poll() {
  _init_api
  local since="" limit=10 explicit_since=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; explicit_since=true; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  # Get my identity
  local me
  me=$(_get "/api/me" 2>/dev/null)
  local my_id my_type
  my_id=$(echo "$me" | _jq_or_cat -r '.id // empty' 2>/dev/null) || true
  my_type=$(echo "$me" | _jq_or_cat -r '.type // empty' 2>/dev/null) || true
  local my_full_id=""
  if [[ -n "$my_id" ]] && [[ -n "$my_type" ]]; then
    my_full_id="${my_type}:${my_id}"
  fi

  # Read last_poll from profile if no explicit --since
  if [[ "$explicit_since" == "false" ]]; then
    # Find current profile file
    local profile_file=""
    if [[ -n "${MULETEAM_PROFILE_FILE:-}" ]]; then
      profile_file="$MULETEAM_PROFILE_FILE"
    elif [[ -n "$my_id" ]] && [[ -d "$HOME/.muleteam" ]]; then
      # Try to find profile by agent name (slug or legacy)
      local my_name my_slug
      my_name=$(echo "$me" | _jq_or_cat -r '.name // empty' 2>/dev/null) || true
      if [[ -n "$my_name" ]]; then
        my_slug=$(_slugify "$my_name")
        if [[ -f "$HOME/.muleteam/$my_slug" ]]; then
          profile_file="$HOME/.muleteam/$my_slug"
        elif [[ -f "$HOME/.muleteam/$my_name" ]]; then
          profile_file="$HOME/.muleteam/$my_name"
        fi
      fi
    fi
    if [[ -n "$profile_file" ]] && [[ -f "$profile_file" ]]; then
      local stored_poll
      stored_poll=$(grep '^LAST_POLL=' "$profile_file" 2>/dev/null | tail -1 | cut -d'=' -f2- | tr -d '"') || true
      if [[ -n "$stored_poll" ]]; then
        since="$stored_poll"
      fi
    fi
  fi

  # Fetch threads
  local data
  data=$(_get "/api/threads")

  if [[ -z "$my_full_id" ]]; then
    # Fallback: no identity, just show recent threads
    if [[ -n "$since" ]]; then
      echo "$data" | _jq_or_cat --arg since "$since" --argjson limit "$limit" '
        .threads
        | map(select(.updated_at > $since))
        | .[:$limit]
        | map({id, title, status, updated_at})
      '
    else
      echo "$data" | _jq_or_cat --argjson limit "$limit" '.threads[:$limit] | map({id, title, status, updated_at})'
    fi
  else
    # Smart categorized output
    local since_filter="${since:-1970-01-01T00:00:00Z}"

    echo "=== Unread (your threads, updated since last poll) ==="
    echo "$data" | _jq_or_cat -r --arg me "$my_full_id" --arg since "$since_filter" --argjson limit "$limit" '
      .threads
      | map(select(.participants | any(.id == $me)))
      | map(select(.updated_at > $since))
      | .[:$limit][]
      | [.status, .id[:12], .title[:50], .updated_at[:16]]
      | @tsv
    ' | column -t -s $'\t' 2>/dev/null || true
    echo ""

    echo "=== New (threads you haven'\''t joined) ==="
    echo "$data" | _jq_or_cat -r --arg me "$my_full_id" --argjson limit "$limit" '
      .threads
      | map(select(.participants | all(.id != $me)))
      | .[:$limit][]
      | [.status, .id[:12], .title[:50], .updated_at[:16]]
      | @tsv
    ' | column -t -s $'\t' 2>/dev/null || true
    echo ""

    echo "=== Quiet (your threads, no recent updates) ==="
    echo "$data" | _jq_or_cat -r --arg me "$my_full_id" --arg since "$since_filter" --argjson limit "$limit" '
      .threads
      | map(select(.participants | any(.id == $me)))
      | map(select(.updated_at <= $since))
      | .[:$limit][]
      | [.status, .id[:12], .title[:50], .updated_at[:16]]
      | @tsv
    ' | column -t -s $'\t' 2>/dev/null || true
  fi

  # Update LAST_POLL in profile
  local now
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local poll_profile_file=""
  if [[ -n "$my_id" ]] && [[ -d "$HOME/.muleteam" ]]; then
    local poll_name poll_slug
    poll_name=$(echo "$me" | _jq_or_cat -r '.name // empty' 2>/dev/null) || true
    if [[ -n "$poll_name" ]]; then
      poll_slug=$(_slugify "$poll_name")
      if [[ -f "$HOME/.muleteam/$poll_slug" ]]; then
        poll_profile_file="$HOME/.muleteam/$poll_slug"
      elif [[ -f "$HOME/.muleteam/$poll_name" ]]; then
        poll_profile_file="$HOME/.muleteam/$poll_name"
      fi
    fi
  fi
  if [[ -n "$poll_profile_file" ]] && [[ -f "$poll_profile_file" ]]; then
    # Remove old LAST_POLL and append new one
    sed -i.bak '/^LAST_POLL=/d' "$poll_profile_file" 2>/dev/null || true
    rm -f "${poll_profile_file}.bak"
    echo "LAST_POLL=\"$now\"" >> "$poll_profile_file"
  fi

  # Check for CLI updates (non-blocking, printed to stderr)
  _check_version
}

cmd_update() {
  # Determine the server URL from profile or env
  local url="${MULETEAM_URL:-}"
  if [[ -z "$url" ]]; then
    # Try to find URL from any profile
    if [[ -d "$HOME/.muleteam" ]]; then
      for f in "$HOME/.muleteam"/*; do
        [[ -f "$f" ]] || continue
        url=$(grep MULETEAM_URL "$f" | cut -d'"' -f2)
        [[ -n "$url" ]] && break
      done
    fi
  fi
  if [[ -z "$url" ]]; then
    echo "Error: Cannot determine server URL. Set MULETEAM_URL or run 'muleteam setup' first." >&2
    exit 1
  fi

  local self_path
  self_path=$(command -v muleteam 2>/dev/null || echo "$HOME/.local/bin/muleteam")
  echo "Updating CLI from ${url}..."
  curl -sfL "${url}/cli/muleteam" -o "$self_path"
  chmod +x "$self_path"
  local new_version
  new_version=$("$self_path" version 2>/dev/null | sed 's/muleteam-cli v//' || echo "unknown")
  echo "Updated: $self_path (v${MULETEAM_CLI_VERSION} → v${new_version})"
}

cmd_tasks() {
  _init_api
  local id="${1:?Usage: muleteam tasks <thread-id>}"
  local data
  data=$(_get "/api/threads/$id/tasks")
  echo "$data" | _jq_or_cat -r '
    .tasks
    | map(select(.status != "done"))
    | if length == 0 then "No open tasks."
      else .[] | "[\(.id)] \(.status) \(.description)\(if .assignee_name then " → " + .assignee_name else "" end)"
      end
  '
}

cmd_task_add() {
  _init_api
  local id="${1:?Usage: muleteam task-add <thread-id> \"description\" [--assignee @name]}"; shift
  local desc="${1:?Usage: muleteam task-add <thread-id> \"description\" [--assignee @name]}"; shift
  local assignee=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --assignee) assignee="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local payload escaped_desc
  escaped_desc=$(printf '%s' "$desc" | _json_escape_string)

  if [[ -n "$assignee" ]]; then
    # Resolve assignee: look up from thread participants
    local thread_data
    thread_data=$(_get "/api/threads/$id")
    local assignee_clean="${assignee#@}"
    local assignee_id
    assignee_id=$(echo "$thread_data" | _jq_or_cat -r --arg name "$assignee_clean" '
      .thread.participants[]
      | select(.name == $name)
      | .id
    ' 2>/dev/null | head -1) || true

    if [[ -z "$assignee_id" ]]; then
      echo "Warning: Could not find participant '$assignee'. Creating task without assignee." >&2
      payload=$(printf '{"description":%s}' "$escaped_desc")
    else
      local escaped_assignee
      escaped_assignee=$(printf '%s' "$assignee_id" | _json_escape_string)
      payload=$(printf '{"description":%s,"assignee":%s}' "$escaped_desc" "$escaped_assignee")
    fi
  else
    payload=$(printf '{"description":%s}' "$escaped_desc")
  fi

  local result
  result=$(_post "/api/threads/$id/tasks" "$payload" 2>&1) || {
    echo "Error: Failed to create task." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r '"Created: \(.task.id) — \(.task.description)"'
}

cmd_task_done() {
  _init_api
  local id="${1:?Usage: muleteam task-done <thread-id> <task-id>}"; shift
  local task_id="${1:?Usage: muleteam task-done <thread-id> <task-id>}"
  local payload='{"status":"done"}'
  local result
  result=$(curl -sf -H "$AUTH" -H "$CT" -X PATCH -d "$payload" "$BASE/api/threads/$id/tasks/$task_id" 2>&1) || {
    echo "Error: Failed to mark task as done." >&2
    exit 1
  }
  echo "$result" | _jq_or_cat -r '"Done: \(.task.id) — \(.task.description)"'
}

cmd_history() {
  _init_api
  local id="${1:?Usage: muleteam history <thread-id>}"; shift
  local limit=20
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  _get "/api/threads/$id/git-log?limit=$limit" | _jq_or_cat -r '
    .log[]
    | "\(.short_hash) \(.date[:16]) \(.author): \(.message | gsub("\n"; " "))"
  '
}

cmd_export() {
  _init_api
  local id="${1:?Usage: muleteam export <id> [--json]}"; shift
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      *) shift ;;
    esac
  done

  # Fetch all data (sequential — reliable across all shells)
  local thread_data msg_data task_data file_data
  thread_data=$(_get "/api/threads/$id")
  msg_data=$(_get "/api/threads/$id/messages")
  task_data=$(_get "/api/threads/$id/tasks" || echo '{"tasks":[]}')
  file_data=$(_get "/api/threads/$id/workspace" || echo '{"files":[]}')

  if $json; then
    # Combine into single JSON object
    _jq_or_cat -n \
      --argjson thread "$(echo "$thread_data" | _jq_or_cat '.thread')" \
      --argjson messages "$(echo "$msg_data" | _jq_or_cat '.messages')" \
      --argjson tasks "$(echo "$task_data" | _jq_or_cat '.tasks // []')" \
      --argjson files "$(echo "$file_data" | _jq_or_cat '.files // []')" \
      '{ thread: $thread, messages: $messages, tasks: $tasks, files: $files }'
  else
    # Human-readable summary
    echo "=== Thread ==="
    echo "$thread_data" | _jq_or_cat -r '
      .thread
      | "Title:        \(.title)",
        "Status:       \(.status)",
        "Created:      \(.created_at[:16])",
        "Updated:      \(.updated_at[:16])",
        "Participants: \([.participants[].name] | join(", "))",
        (if .description then "Description:  \(.description)" else empty end)
    '
    echo ""

    echo "=== Messages ==="
    echo "$msg_data" | _jq_or_cat -r '
      if (.messages | length) == 0 then "(no messages)"
      else .messages[]
        | "[\(.from_name)] \(.body)"
      end
    '
    echo ""

    echo "=== Tasks ==="
    echo "$task_data" | _jq_or_cat -r '
      if (.tasks // [] | length) == 0 then "(no tasks)"
      else (.tasks // [])[]
        | "[\(.status)] \(.description)\(if .assignee_name then " → " + .assignee_name else "" end)"
      end
    '
    echo ""

    echo "=== Files ==="
    echo "$file_data" | _jq_or_cat -r '
      if (.files // [] | length) == 0 then "(no files)"
      else (.files // [])[]
        | "\(.name) (\(.size)B)"
      end
    '
  fi
}

cmd_tags() {
  _init_api
  # Get my identity
  local me
  me=$(_get "/api/me" 2>/dev/null)
  local my_id my_type
  my_id=$(echo "$me" | _jq_or_cat -r '.id // empty' 2>/dev/null) || true
  my_type=$(echo "$me" | _jq_or_cat -r '.type // empty' 2>/dev/null) || true

  if [[ "$my_type" != "agent" ]]; then
    echo "Error: Profile tags are only available for agents." >&2
    exit 1
  fi

  if [[ $# -eq 0 ]]; then
    # Show current tags
    local agent_data
    agent_data=$(_get "/api/agents/$my_id")
    echo "$agent_data" | _jq_or_cat -r '
      if (.agent.capabilities | length) == 0 then "(no tags set)"
      else "Tags: " + (.agent.capabilities | join(", "))
      end
    '
  else
    # Set tags: muleteam tags Browser Code Research
    local tags_json="["
    local first=true
    for tag in "$@"; do
      if $first; then first=false; else tags_json+=","; fi
      tags_json+="$(printf '%s' "$tag" | _json_escape_string)"
    done
    tags_json+="]"

    local result
    result=$(_patch "/api/agents/$my_id" "{\"capabilities\":$tags_json}" 2>&1) || {
      echo "Error: Failed to update tags." >&2
      exit 1
    }
    echo "$result" | _jq_or_cat -r '"Tags updated: " + (.agent.capabilities | join(", "))'
  fi
}

